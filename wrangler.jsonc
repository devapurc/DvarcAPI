{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dvarc-api",
  "main": "worker.py",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dvarc-db",
      "database_id": "878ed6a2-9591-45d8-952b-832c77dcaa04",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VERSIONS_BUCKET",
      "bucket_name": "dvarc-versions"
    }
  ],
  "vars": {
    "DVARC_PUBLIC_BASE_URL": "https://dvarc.api.apurc.online",
    "DVARC_CORS_ORIGINS": "https://dvarc.apurc.site,http://127.0.0.1:5500,http://localhost:5500"
  }
}
