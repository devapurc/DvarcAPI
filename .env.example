# Configuracion de Dvarc API (copiar a .env o definir como variables de entorno)

# Interfaz y puerto donde escucha uvicorn
DVARC_HOST=127.0.0.1
DVARC_PORT=8765

# Carpetas (relativas a este proyecto o absolutas)
DVARC_VERSIONS_DIR=versions
DVARC_DATA_DIR=data

# Limite de emision de tokens: cantidad por ventana (0 desactiva el limite)
DVARC_TOKEN_RATE_LIMIT=10
DVARC_TOKEN_RATE_WINDOW=60

# URL publica opcional para devolver URLs absolutas en los manifiestos
# DVARC_PUBLIC_BASE_URL=https://api.dvarc.example.com

# Origenes permitidos por CORS (el sitio publico)
# DVARC_CORS_ORIGINS=https://dvarc.apurc.site,http://127.0.0.1:5500,http://localhost:5500
